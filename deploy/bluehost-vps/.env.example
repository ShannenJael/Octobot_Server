HOST=marketaioctobot.com
LETSENCRYPT_EMAIL=replace-with-your-email@example.com
# Pinned: octobot:stable (3.0.0-beta3) is missing flask_socketio and breaks the web UI
OCTOBOT_BASE_IMAGE=drakkarsoftware/octobot:3.0.0-beta2
OCTOBOT_HOST_PORT=5002

# Keep AI wording disabled unless an API key has been added intentionally.
MARKET_RADAR_AI_ENABLED=false
MARKET_RADAR_AI_MODEL=gpt-5-mini
MARKET_RADAR_PAPER_HANDOFF_ENABLED=false
OPENAI_API_KEY=
